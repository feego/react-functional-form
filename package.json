{
  "name": "@feego/react-functional-form",
  "version": "1.0.0",
  "description": "Schema-first, fully controlled, composable forms for React — with nested forms, field arrays, async validation and Standard Schema (Zod, Valibot, ArkType) support.",
  "author": "Rui Monteiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feego/react-functional-form.git"
  },
  "homepage": "https://feego.github.io/react-functional-form",
  "bugs": "https://github.com/feego/react-functional-form/issues",
  "keywords": [
    "react",
    "form",
    "forms",
    "hooks",
    "validation",
    "controlled",
    "nested-forms",
    "field-array",
    "zod",
    "valibot",
    "standard-schema",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:exports": "publint && attw --pack .",
    "size": "size-limit",
    "examples:dev": "pnpm --filter examples dev",
    "examples:build": "pnpm --filter examples build",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=16.8"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "7 KB"
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@standard-schema/spec": "^1.1.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "arktype": "^2.2.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "valibot": "^1.5.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
